{
  "name": "pair-control",
  "version": "0.1.0",
  "private": true,
  "description": "Codex·Claude 병렬 개발을 사람이 제어하는 로컬 관제 도구 (mock 기본)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "demo:fixture": "node scripts/make-fixture.mjs",
    "guard:status": "node scripts/guard.mjs status",
    "guard:ack": "node scripts/guard.mjs ack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "MASTRA_TELEMETRY_DISABLED=1 node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "@mastra/libsql": "1.27.0",
    "zod": "4.6.7",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "mastra": "1.35.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
